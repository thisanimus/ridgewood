<header class="masthead">
			<a class="brand" href="index.html" aria-label="{{ site.name }}, home">
				<img src="assets/img/ridgewood-seal.svg" alt="" width="52" height="52" />
				<img src="assets/img/ridgewood-wordmark.svg" alt="" width="176" height="55" />
			</a>
			<nav aria-label="Primary">
				<ol>
					{%- for item in site.nav %}
					<li><a href="{{ item.href }}"{% if item.key == nav %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
					{%- endfor %}
					<li><a href="{{ site.clientPortal }}">Clients</a></li>
				</ol>
			</nav>
		</header>
