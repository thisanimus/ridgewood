<header class="masthead wrap">
				<div class="masthead__bar">
					<a class="brand" href="index.html" aria-label="{{ site.name }}, home">
						<img class="brand__seal" src="assets/img/ridgewood-seal.svg" alt="" width="52" height="52" />
						<img class="brand__word" src="assets/img/ridgewood-wordmark.svg" alt="" width="176" height="55" />
					</a>
					<nav class="nav" aria-label="Primary">
						<ol>
							{%- for item in site.nav %}
							<li><a href="{{ item.href }}"{% if item.key == nav %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
							{%- endfor %}
							<li><a class="nav__ext" href="{{ site.clientPortal }}">Clients</a></li>
						</ol>
					</nav>
				</div>
			</header>
