<footer class="colophon">
				<div class="wrap">
					<div class="grid">
						<div class="span-4">
							<a class="colophon__brand" href="index.html" aria-label="{{ site.name }}, home">
								<img src="assets/img/ridgewood-seal-white.svg" alt="" width="56" height="56" />
								<img src="assets/img/ridgewood-wordmark-white.svg" alt="" width="184" height="58" />
							</a>
						</div>
						<div class="colophon__col span-3 start-6">
							<h2 class="label">Contact</h2>
							<address>
								<a href="{{ site.address.map }}">{{ site.address.lines | join: "<br />" }}</a>
							</address>
							<a class="colophon__phone" href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a>
						</div>
						<div class="colophon__col span-2">
							<h2 class="label">Connect</h2>
							<ul>
								{%- for item in site.social %}
								<li><a href="{{ item.href }}">{{ item.label }} ↗</a></li>
								{%- endfor %}
							</ul>
						</div>
						<div class="colophon__col span-2">
							<h2 class="label">Legal</h2>
							<ul>
								{%- for item in site.legal %}
								<li><a href="{{ item.href }}">{{ item.label }}</a></li>
								{%- endfor %}
							</ul>
						</div>
					</div>

					<div class="folio meta">
						<span>© {{ "now" | date: "%Y" }} {{ site.legalName }}</span>
					</div>
				</div>
			</footer>
