---
layout: layouts/base.liquid
permalink: /contact.html
nav: contact
title: "Contact — Ridgewood Wealth Management"
description: "Get in touch with Ridgewood Wealth Management in Southlake, Texas. Send us a message and we’ll be in touch."
scripts:
  - https://challenges.cloudflare.com/turnstile/v0/api.js
---
<main id="main">
	<section class="contact wrap grid" aria-labelledby="page-title">
		<div class="span-5">
			<h1 id="page-title" class="title-xl">Contact</h1>
			<p class="lede">Whether you’re ready to get started, or just curious about what we can do for you, <em>we’d love to hear from you.</em></p>
		</div>

		<!--
			Contact form contract (for the Cloudflare Pages Function at
			functions/api/contact.js):
			  · POST /api/contact, application/x-www-form-urlencoded
			  · fields: name, email, message (all required); company is a
			    honeypot — drop the submission if it has a value
			  · respond 303 → /contact.html#message-sent on success,
			    or /contact.html#message-error on failure
			  · the Turnstile widget adds a cf-turnstile-response field, verified
			    in the Function
			The confirmations below show via :target, no page JavaScript needed.
		-->
		<div class="span-6 start-7">
			<p class="form-status" id="message-sent" role="status">
				<strong>Thank you.</strong> Your message is on its way — we’ll be in touch soon.
			</p>
			<p class="form-status form-status-error" id="message-error" role="alert">
				<strong>Sorry, something went wrong.</strong> Please try again, or call us at
				<a href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a>.
			</p>

			<form action="/api/contact" method="post">
				<div class="field">
					<label class="label" for="cf-name">Name</label>
					<input id="cf-name" name="name" type="text" autocomplete="name" autocapitalize="words" spellcheck="false" placeholder="Jane Smith" required maxlength="200">
				</div>
				<div class="field">
					<label class="label" for="cf-email">Email</label>
					<input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="jane@example.com" required maxlength="320">
				</div>
				<div class="field">
					<label class="label" for="cf-message">Message</label>
					<textarea id="cf-message" name="message" rows="7" autocomplete="off" placeholder="I’m approaching retirement and would like to talk about an income strategy and our estate plan." required maxlength="5000"></textarea>
				</div>
				<!-- Honeypot: hidden from people, often filled in by bots -->
				<div class="honeypot" aria-hidden="true">
					<label for="cf-company">Company</label>
					<input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off">
				</div>
				{%- if site.turnstileSiteKey %}
				<div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-size="flexible" data-theme="light"></div>
				{%- endif %}
				<div class="actions">
					<button class="button" type="submit">Send message</button>
					<p class="meta muted">All fields required</p>
				</div>
			</form>
		</div>
	</section>
</main>
